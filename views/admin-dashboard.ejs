<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CMS Dashboard Manager</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <header>
        <div class="nav-container">
            <h1>CMS Panel<span>.control</span></h1>
            <nav><a href="/">View Site</a><a href="/admin/logout" style="color: #ef4444;">Logout</a></nav>
        </div>
    </header>
    <main style="margin-top: 30px;">
        
        <!-- SECTION 1: UPDATE ABOUT ME CONTENT -->
        <section class="admin-box">
            <h4>Update About Me Markdown Content</h4>
            <form action="/admin/update-about" method="POST">
                <textarea name="aboutContent" class="admin-textarea" required><%= aboutText %></textarea>
                <button type="submit" class="admin-btn">Save About Changes</button>
            </form>
        </section>

        <!-- SECTION 2: SHOWCASE PROJECTS MANAGER -->
        <section class="admin-box">
            <h4>Update Showcase Projects</h4>
            <div style="display: grid; grid-template-columns: 1fr; gap: 20px; margin-top: 15px;">
                <% projects.forEach(p => { %>
                    <div style="border: 1px solid var(--border); padding: 15px; border-radius: 8px; position: relative;">
                        <h5>Project Card #<%= p.id %>: <%= p.title %></h5>
                        <form action="/admin/update-project/<%= p.id %>" method="POST" enctype="multipart/form-data">
                            <input type="text" name="title" class="admin-input" value="<%= p.title %>" required placeholder="Project Title">
                            <input type="text" name="desc" class="admin-input" value="<%= p.desc %>" required placeholder="Project Description">
                            <input type="text" name="link" class="admin-input" value="<%= p.link %>" required placeholder="Project Link Prefix (https://)">
                            <label style="font-size:0.8rem; display:block; margin-top:10px;">Replace Project Image File</label>
                            <input type="file" name="projectImg" class="admin-input">
                            
                            <div style="display: flex; gap: 10px;">
                                <button type="submit" class="admin-btn" style="background:#10b981; color:#fff;">Save Card</button>
                        </form>
                        <!-- Delete Project Entry Submittal Form Inline Button Trigger -->
                        <form action="/admin/delete-project/<%= p.id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this project card permanently?');">
                            <button type="submit" class="delete-btn">Delete Project</button>
                        </form>
                        </div>
                    </div>
                <% }) %>
            </div>
        </section>

        <!-- SECTION 3: ARTICLES INVENTORY LIST & CREATOR MODULE -->
        <section class="admin-box">
            <h4>Publish a New Tech Article with Thumbnail Card Image</h4>
            <form action="/admin/create-article" method="POST" enctype="multipart/form-data" style="margin-bottom: 30px;">
                <input type="text" name="slug" class="admin-input" placeholder="article-url-slug (e.g. building-my-app)" required>
                <input type="text" name="title" class="admin-input" placeholder="Article Display Title" required>
                <textarea name="markdown" class="admin-textarea" placeholder="## Write markdown layout text body..." required></textarea>
                <label style="font-size:0.8rem; display:block; margin-top:10px;">Article Cover Image Thumbnail</label>
                <input type="file" name="thumbnail" class="admin-input" required>
                <button type="submit" class="admin-btn">Publish Article Logs</button>
            </form>

            <hr style="border:0; border-top: 1px solid var(--border); margin: 30px 0;">

            <h4>Manage Published Technical Articles</h4>
            <div style="margin-top: 15px; display: flex; flex-direction: column; gap: 12px;">
                <% if (typeof articles !== 'undefined' && articles.length > 0) { %>
                    <% articles.forEach(article => { %>
                        <div style="display:flex; justify-content:space-between; align-items:center; border: 1px solid var(--border); padding:15px; border-radius:8px; background: rgba(255,255,255,0.02);">
                            <span>📝 <strong><%= article.title %></strong> (<%= article.slug %>)</span>
                            
                            <!-- THE ARTICLE DELETE BUTTON FORM MODULE -->
                            <form action="/admin/delete-article/<%= article.slug %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this article log permanently?');" style="margin: 0;">
                                <button type="submit" class="delete-btn" style="margin-top:0;">Delete</button>
                            </form>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p style="color: var(--text-muted); font-size:0.9rem;">No articles found to manage. Post an article above to populate this management list.</p>
                <% } %>
            </div>

        </section>
    </main>
</body>
</html>
