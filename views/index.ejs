<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://cloudflare.com">

</head>
<body>

    <header>
        <div class="nav-container">
            <h1>Olan<span>sile.</span></h1>
            <button class="menu-toggle" id="menuToggle">
                <span></span><span></span><span></span>
            </button>
            <nav id="navMenu">
                <a href="#about" onclick="toggleMenu()">About</a>
                <!-- <a href="#skills" onclick="toggleMenu()">Skills</a> -->
                <a href="#projects" onclick="toggleMenu()">Projects</a>
                <a href="#articles" onclick="toggleMenu()">Articles</a>
                 <a href="#contact" onclick="toggleMenu()">Contact</a> 
                <a href="https://github.com" target="_blank" style="color: var(--accent); font-weight:600;">GitHub</a>
                <a href="https://linkedin.com" target="_blank" style="color: var(--accent); font-weight:600;">LinkedIn</a>
            </nav>
        </div>
    </header>

    <!-- HERO SECTION GRID WITH PROFILE PICTURE ENTRY -->
    <section class="hero">
        <div class="hero-grid">
            <div class="hero-content">
                <h3 class="hero-welcome">Welcome to Olansile Portfolio</h3>
                <h2>Designing Digital Experiences with <span>Modern Code Engine</span></h2>
                <p>I build robust backend microservices, modular APIs, and fast, fully responsive web systems tailored for performance.</p>
                <a href="#projects" class="cta-btn">Explore My Featured Projects</a>
            </div>
            <div class="hero-image-box">
                <div class="profile-img-wrapper">
                    <img src="/uploads/profile.png" alt="Olansile Profile Photo">
                </div>
            </div>
        </div>
    </section>

    <main>
        <!-- UPDATED ABOUT SECTION WITH DYNAMIC PROFILE COLUMNS -->
        <section id="about">
            <h3 class="section-title">About Me</h3>
            <div class="about-wrapper">
                
                <!-- Left Side: Dynamic Markdown Description -->
                <div class="about-bio">
                    <%- about %>
                </div>

                <!-- Right Side: Graphic Technical Visual Metrics Dashboard -->
                <div class="about-stats">
                    <div class="stat-box">
                        <div class="stat-icon">💻</div>
                        <div class="stat-info">
                            <h6>Specialization</h6>
                            <p>Full-Stack Node.js Engineer</p>
                        </div>
                    </div>
                    
                    <div class="stat-box">
                        <div class="stat-icon">⚡</div>
                        <div class="stat-info">
                            <h6>Core Philosophy</h6>
                            <p>Minimal Dependencies, High Performance</p>
                        </div>
                    </div>

                    <div class="stat-box">
                        <div class="stat-icon">🎯</div>
                        <div class="stat-info">
                            <h6>Current Focus</h6>
                            <p>API Architecture & Scalable SSR</p>
                        </div>
                    </div>

                    <div class="stat-box">
                        <div class="stat-icon">📍</div>
                        <div class="stat-info">
                            <h6>Location Availability</h6>
                            <p>Lagos, NG & Remote Roles</p>
                        </div>
                    </div>
                </div>

            </div>
        </section>


        <!-- PROJECTS GRID SECTION -->
        <section id="projects">
            <h3 class="section-title">Featured Projects</h3>
            <div class="grid">
                <% projects.forEach(project => { %>
                    <div class="project-card">
                        <div class="project-image-box">
                            <img src="<%= project.img %>" alt="<%= project.title %> Graphic">
                        </div>
                        <div class="project-body">
                            <h4><%= project.title %></h4>
                            <p><%= project.desc %></p>
                            <a href="<%= project.link %>" class="project-link" target="_blank">Source Repository &rarr;</a>
                        </div>
                    </div>
                <% }) %>
            </div>
        </section>

        <!-- ARTICLES GRID WITH THUMBNAILS -->
        <section id="articles">
            <h3 class="section-title">Technical Articles</h3>
            <% if (articles.length === 0) { %>
                <div class="card"><p style="color: var(--text-muted);">No logs or writeups cataloged yet.</p></div>
            <% } else { %>
                <div class="articles-list">
                    <% articles.forEach(article => { %>
                        <div class="article-item">
                            <div class="article-thumb">
                                <img src="<%= article.thumbnail %>" alt="<%= article.title %> Cover">
                            </div>
                            <div class="article-content-block">
                                <a href="/articles/<%= article.slug %>">📝 <%= article.title %></a>
                                <span style="color: var(--accent); font-size: 0.85rem;">Read Article &rarr;</span>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </section>
        <!-- CONTACT FORM SECTION -->
        <section id="contact">
            <h3 class="section-title">Get In Touch</h3>
            
            <!-- Success Message Notification Bar -->
            <% if (typeof successMsg !== 'undefined' && successMsg) { %>
                <div class="alert-success">
                    🚀 Thank you! Your message has been sent successfully. I will get back to you shortly.
                </div>
            <% } %>

            <div class="card">
                <div class="contact-grid">
                    
                    <!-- Left: Quick Direct Contact Details Info Box -->
                    <div class="contact-info-card">
                        <div class="contact-method">
                            <div class="contact-method-icon">📧</div>
                            <div class="contact-method-text">
                                <h5>Email Me</h5>
                                <a href="mailto:olansile@example.com">olansile@example.com</a>
                            </div>
                        </div>
                        <div class="contact-method">
                            <div class="contact-method-icon">📞</div>
                            <div class="contact-method-text">
                                <h5>Call / WhatsApp</h5>
                                <p>+234 810 321 9605</p>
                            </div>
                        </div>
                        <div class="contact-method">
                            <div class="contact-method-icon">📍</div>
                            <div class="contact-method-text">
                                <h5>Location</h5>
                                <p>Lagos, Nigeria</p>
                            </div>
                        </div>
                    </div>

                    <!-- Right: Dynamic Form Fields Processing Module -->
                    <form action="/contact/send" method="POST" class="contact-form">
                        <div class="form-group">
                            <label for="name">Your Name</label>
                            <input type="text" id="name" name="name" class="form-control" required placeholder="John Doe">
                        </div>
                        <div class="form-group">
                            <label for="email">Email Address</label>
                            <input type="email" id="email" name="email" class="form-control" required placeholder="johndoe@example.com">
                        </div>
                        <div class="form-group">
                            <label for="message">Message</label>
                            <textarea id="message" name="message" class="form-control" required placeholder="Hi Olansile, let's collaborate on a project..."></textarea>
                        </div>
                        <button type="submit" class="submit-btn">Send Message &rarr;</button>
                    </form>

                </div>
            </div>
        </section>


    </main>

    <footer>
        <div class="footer-grid">

            <div class="footer-col">
                <h5>Contact Details</h5>
                <a href="mailto:info@olansile.name.ng">📧 info@olansile.name.ng</a>
                                <a href="https://wa.me/2348103219605" target="_blank" class="whatsapp-footer-btn">
                    <img src="/uploads/whatsapp-icon.png" alt="WhatsApp Icon" style="width: 20px; height: 20px; margin-right: 8px;">
                    Chat on WhatsApp
                </a>
                <p>📞 +234 810 321 9605</p>
                <p>📞 +234 701 142 6076</p>
                <p>📍 Lagos, Nigeria</p>
            </div>
            <div class="footer-col">
                <h5>Connect</h5>
                <a href="https://github.com" target="_blank">&rarr; GitHub Profile</a>
                <a href="https://linkedin.com" target="_blank">&rarr; LinkedIn Network</a>

            </div>
                        <div class="footer-col">
                <h5>Olansile.</h5>
                <p>Full-Stack Web Engineering Specialist focused on performance and scalable execution structures.</p>
                
            </div>
        </div>
        <hr style="border: 0; border-top: 1px solid var(--border); margin: 20px 0;">
        <p>&copy; 2026 Olansile. Built securely with Node.js & Express.</p>
    </footer>

    <script>
        const menuToggle = document.getElementById('menuToggle');
        const navMenu = document.getElementById('navMenu');
        menuToggle.addEventListener('click', () => {
            menuToggle.classList.toggle('active');
            navMenu.classList.toggle('active');
        });
        function toggleMenu() {
            if (window.innerWidth <= 768) {
                menuToggle.classList.remove('active');
                navMenu.classList.remove('active');
            }
        }
    </script>
</body>
</html>
